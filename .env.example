# 复制为 .env 后按需修改;全部有默认值
PORT=8000
# 建议设置:REST 调用需带 Authorization: Bearer <token>(skill 里也要配同一个)
API_TOKEN=
# 官方音色同步源;大陆网络保持 hf-mirror 即可
HF_ENDPOINT=https://hf-mirror.com
# 启动时自动同步官方最新音色(结果缓存在 ./data,断网也能启动)
SYNC_ON_STARTUP=true
# 输出峰值归一化目标(修复 kokoro 原生声音偏轻)
DEFAULT_PEAK_TARGET=0.95
# 默认音色组: v1.1-zh(中文 100+英 3) / v1.0(经典 54)
DEFAULT_MODEL=v1.1-zh
MEM_LIMIT=2g
