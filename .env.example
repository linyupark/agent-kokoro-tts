# 复制为 .env 后按需修改;全部有默认值
PORT=8000
# 建议设置:REST 调用需带 Authorization: Bearer <token>(skill 里也要配同一个)
API_TOKEN=
# 官方音色同步源;大陆网络保持 hf-mirror 即可
HF_ENDPOINT=https://hf-mirror.com
# 启动时自动同步官方最新音色(结果缓存在 ./data,断网也能启动)
SYNC_ON_STARTUP=true
# 输出峰值归一化目标(修复 kokoro 原生声音偏轻)
DEFAULT_PEAK_TARGET=0.95
# 默认音色组: v1.1-zh(中文 100+英 3) / v1.0(经典 54)
DEFAULT_MODEL=v1.1-zh
MEM_LIMIT=2g
# --- 内存相关(见 README「资源与稳定性」) ---
# 同时最多几个合成任务;并发会成倍放大 ONNX 推理的工作区
MAX_CONCURRENCY=2
# ONNX Runtime 的 CPU 内存池:false = 用完即还(峰值低,单请求慢约 10%)
ORT_MEM_ARENA=false
# 每个推理实例的算子内线程数;核少的机器可设 2
ORT_INTRA_THREADS=4
# 连续多少分钟没有请求就卸载模型、把内存还给系统;0 = 常驻不卸载
IDLE_UNLOAD_MIN=30
